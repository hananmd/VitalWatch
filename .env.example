# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL (local Docker Compose only)
POSTGRES_DB=vitalwatch
POSTGRES_USER=vitalwatch
POSTGRES_PASSWORD=change-me

# Backend
VITALWATCH_ENVIRONMENT=local
VITALWATCH_LOG_LEVEL=INFO

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# This placeholder only lets local Compose start. Replace it before real use.
VITALWATCH_JWT_SECRET=replace-with-output-of-secrets-token-urlsafe-32

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitalwatch.local/contracts/device-reading.schema.json",
  "title": "DeviceReading",
  "description": "Message sent by a wearable device. One message holds the measurements taken at one moment. The tenant and patient are NOT sent by the device; ingestion looks them up from the authenticated device.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "device_id", "event_time", "metrics"],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "message_id": {
      "description": "UUID generated by the device per message and reused on retry. Used with device_id to drop duplicates.",
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "description": "Must match the authenticated device; ingestion rejects mismatches.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "event_time": {
      "description": "When the device took the measurement, UTC, RFC 3339 with offset.",
      "type": "string",
      "format": "date-time"
    },
    "seq": {
      "description": "Optional per-device counter, increasing by one per message. Helps detect gaps.",
      "type": "integer",
      "minimum": 0
    },
    "battery_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    }
  },
  "$defs": {
    "metrics": {
      "description": "At least one metric must be present. Ranges reject physically impossible values only; implausible but possible values are left to the engines.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "heart_rate_bpm": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "skin_temperature_c": {
          "type": "number",
          "minimum": 20,
          "maximum": 45
        },
        "steps": {
          "description": "Steps since the previous message.",
          "type": "integer",
          "minimum": 0
        },
        "accelerometer": {
          "$ref": "#/$defs/accelerometer"
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "accelerometer": {
      "description": "A window of raw samples starting at event_time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate_hz", "samples_g"],
      "properties": {
        "sample_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "samples_g": {
          "description": "[x, y, z] in g, in time order.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": -16, "maximum": 16 },
              { "type": "number", "minimum": -16, "maximum": 16 },
              { "type": "number", "minimum": -16, "maximum": 16 }
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "location": {
      "description": "Raw indoor location signal. Smoothing happens in the movement module, not on the device.",
      "type": "object",
      "additionalProperties": false,
      "required": ["zone_id"],
      "properties": {
        "zone_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
